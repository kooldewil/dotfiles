# Chezmoi
.chezmoi*.yaml

# macOS
.DS_Store

# Secrets - never commit these
*secret*
*private*
*.pem
*.key
# chezmoi uses private_ prefix for 600-permission targets (content is a template, not a secret)
!*private*.tmpl

# Backup files
*.bak
*~
# private_Library is chezmoi's 0700 ~/Library, not a secret; files inside still match the rules above
!home/private_Library/
