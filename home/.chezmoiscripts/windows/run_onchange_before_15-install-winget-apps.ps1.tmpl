{{- if and (eq .chezmoi.os "windows") .work -}}
# Install tools via winget on work machines where Scoop is unavailable
# (e.g. WDAC/ConstrainedLanguage mode prevents Scoop from running).

$ErrorActionPreference = "Stop"

function Write-Status($msg) { Write-Host "  $msg" -ForegroundColor Cyan }
function Write-Ok($msg)     { Write-Host "  [OK] $msg" -ForegroundColor Green }
function Write-Warn($msg)   { Write-Host "  [WARN] $msg" -ForegroundColor Yellow }
function Write-Fail($msg)   { Write-Host "  [ERR] $msg" -ForegroundColor Red }

if (-not (Get-Command winget -ErrorAction SilentlyContinue)) {
    Write-Warn "winget not found - install App Installer from the Microsoft Store."
    exit 0
}

Write-Status "Installing work machine tools via winget..."

$packages = @(
    "AgileBits.1Password",
    "AgileBits.1Password.CLI"
)

$errors = @()

foreach ($id in $packages) {
    $installed = winget list --id $id --exact --accept-source-agreements 2>$null | Select-String $id
    if ($installed) {
        Write-Ok "$id"
    } else {
        Write-Status "Installing $id..."
        winget install --id $id --exact --silent --accept-package-agreements --accept-source-agreements
        if ($LASTEXITCODE -eq 0) {
            Write-Ok "$id installed"
        } else {
            Write-Fail "$id (exit $LASTEXITCODE)"
            $errors += $id
        }
    }
}

if ($errors.Count -gt 0) {
    Write-Warn "Failed to install: $($errors -join ', ')"
    Write-Warn "Install manually - see comments in .chezmoidata/scoop.toml for winget IDs."
    exit 1
}

Write-Host ""
Write-Host "Winget setup complete" -ForegroundColor Green
{{- end }}
