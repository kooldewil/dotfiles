<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mac Mini only (see .chezmoiignore): always-on T3 Code server on the tailnet
     (100.64.0.2:3773) so other devices can pair without the desktop app open.
     The wrapper waits for Tailscale; KeepAlive restarts it if it exits. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.shaunakt.t3-serve</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/shaunakt/.local/bin/t3-serve-tailnet</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>StandardOutPath</key>
	<string>/Users/shaunakt/Library/Logs/t3-serve.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/shaunakt/Library/Logs/t3-serve.log</string>
</dict>
</plist>
