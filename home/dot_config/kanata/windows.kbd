;; windows.kbd — Windows-specific defcfg, defsrc, and deflayers
;; Included first by kanata.kbd.tmpl on windows

(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
  log-layer-changes no
)

;; ============================================================
;; Source Layout - standard PC keyboard (Windows)
;; Note: no fn key, no rmet; bottom row order differs from macOS
;; ============================================================
(defsrc
  esc   f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv   1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab   q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps  a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft  z    x    c    v    b    n    m    ,    .    /    rsft up
  lctl  lmet lalt           spc            @meh rctl left down rght
)

;; ============================================================
;; Base Layer
;; ============================================================
(deflayer base
  esc   f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv   1    2    3    4    5    6    7    8    9    0    -    =    bspc
  @tab-app q w  e    r    t    y    u    i    o    p    [    ]    \
  @hyp  @hm-a @hm-s @hm-d @hm-f g  h  @hm-j @hm-k @hm-l @hm-; '  @ret-nav
  lsft  z    x    c    v    b    n    m    ,    .    /    rsft up
  lctl  lmet lalt         @spc-sym         @meh rctl left down rght
)

;; ============================================================
;; Symbols Layer (hold Space)
;; ============================================================
(deflayer symbols
  _     _    _    _    _    _    _    _    _    _    _    _    _
  _     _    _    _    _    _    _    _    _    _    _    _    _    _
  _     S-1  S-2  S-3  S-4  S-5  S-6  S-7  S-8  S-9  S-0  _    _    _
  _     1    2    3    4    5    6    7    8    9    0    _    _
  _     grv  S-grv S-[ S-]  S-\  -    =    S--  S-=  \    _    _
  _     _    _              _              _    _    _    _    _
)

;; ============================================================
;; Navigation Layer (hold Return)
;; ============================================================
(deflayer navigation
  _     _    _    _    _    _    _    _    _    _    _    _    _
  _     _    _    _    _    _    _    _    _    _    _    _    _    del
  _     _    _    _    _    _    home pgup up   pgdn _    _    _    _
  _     _    _    _    _    _    end  left down rght _    _    _
  _     _    _    _    _    _    _    _    _    _    _    _    _
  _     _    _              _              _    _    _    _    _
)

;; ============================================================
;; Apps Layer (hold Tab)
;; Use: name (cmd start "" "C:\path\to\app.exe")
;; ============================================================
(deflayer apps
  _     _    _    _    _    _    _    _    _    _    _    _    _
  _     _    _    _    _    _    _    _    _    _    _    _    _    _
  _     _    _    _    _    _    _    _    _    _    _    _    _    _
  _     _    _    _    _    _    _    _    _    _    _    _    _
  _     _    _    _    _    _    _    _    _    _    _    _    _
  _     _    _              _              _    _    _    _    _
)

;; ============================================================
;; App Aliases
;; Windows syntax: name (cmd start "" "C:\path\to\app.exe")
;; ============================================================
(defalias
  ;; ----- Example apps (uncomment and modify as needed) -----
  ;;
  ;; chrome  (cmd start "" "C:\Program Files\Google\Chrome\Application\chrome.exe")
  ;; wt      (cmd start "" "wt.exe")
  ;; vscode  (cmd start "" "C:\Users\%USERNAME%\AppData\Local\Programs\Microsoft VS Code\Code.exe")
)
