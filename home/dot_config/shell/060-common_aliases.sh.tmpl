# Common Aliases

# ── Navigation ────────────────────────────────────────────────────────────────
alias ..='cd ../'
alias ...='cd ../../'
alias .3='cd ../../../'
alias .4='cd ../../../../'
alias ~='cd ~'
alias ax='chmod a+x'
alias path='echo -e ${PATH//:/\\n}'

# ── Tool replacements ─────────────────────────────────────────────────────────
{{- if lookPath "bat" }}
alias cat=bat
{{- end }}

{{- if lookPath "eza" }}
alias ls='eza --git --icons=auto'
alias l='eza -l --classify=auto --icons=auto --git'
alias ll='eza -lah --classify=auto --icons=auto --git'
alias llm='ll --sort=modified'
alias la='eza -lbhHigUmuSa --icons=auto --git'
alias lx='eza -lbhHigUmuSa@ --icons=auto --git'
alias lt='eza --tree --level=2 --icons=auto'
alias llt='eza -lah --classify=always --tree --level=2 --icons=auto'
alias ltt='eza -lah --classify=always --icons=auto | grep "$(date +"%d %b")"'
{{- else if eq .chezmoi.os "darwin" }}
alias ls='ls -G'
alias ll='ls -FGlAhpv'
{{- else }}
alias ls='ls --color=auto'
alias ll='ls -FlAhpv --color=auto'
{{- end }}

# ── Git ───────────────────────────────────────────────────────────────────────
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gpl='git pull'
alias gl='git log --oneline --graph --decorate'
alias gd='git diff'
alias gco='git checkout'
alias gb='git branch'

# ── Chezmoi ───────────────────────────────────────────────────────────────────
alias cm='chezmoi'
alias cma='chezmoi apply'
alias cme='chezmoi edit'
alias cmd='chezmoi diff'
alias cmcd='chezmoi cd'
alias cmu='chezmoi update'

# ── Shell ─────────────────────────────────────────────────────────────────────
alias reload='exec zsh'
alias zshconfig='${EDITOR:-nvim} ~/.zshrc'
alias ports='lsof -i -P -n | grep LISTEN'

{{- if eq .chezmoi.os "darwin" }}
# ── macOS ─────────────────────────────────────────────────────────────────────
alias showfiles='defaults write com.apple.finder AppleShowAllFiles YES && killall Finder'
alias hidefiles='defaults write com.apple.finder AppleShowAllFiles NO && killall Finder'
alias emptytrash='sudo rm -rfv /Volumes/*/.Trashes; sudo rm -rfv ~/.Trash'
alias flushdns='sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder'
alias finder='open -a Finder .'
alias afk='pmset displaysleepnow'
alias brewup='brew update && brew upgrade && brew cleanup'
{{- end }}
