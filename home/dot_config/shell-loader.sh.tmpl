#!/usr/bin/env zsh
# Sources numbered shell modules from ~/.config/shell/ in order.
# Files are loaded via numeric sort (005, 010, 020...) so load order is explicit.

SHELL_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/shell"
[[ -d "$SHELL_CONFIG_DIR" ]] || return 0

for _f in "$SHELL_CONFIG_DIR"/*.sh(Nn); do
  [[ -r "$_f" ]] && source "$_f"
done
unset _f
