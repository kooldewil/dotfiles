[[ -o interactive ]] || return
[[ -n "$ZPROF" ]] && zmodload zsh/zprof

export ZSH_CUSTOM="$HOME/.oh-my-zsh/custom"

# p10k instant prompt — must stay near the top
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
DISABLE_AUTO_UPDATE="true"
HIST_STAMPS="yyyy-mm-dd"
ZSH_DISABLE_COMPFIX=true
plugins=()

# Zinit — must init before OMZ so it can load plugins via snippet/light
ZINIT_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/zinit/zinit.git"
if [[ -f "$ZINIT_HOME/zinit.zsh" ]]; then
  source "$ZINIT_HOME/zinit.zsh"
  zinit light Aloxaf/fzf-tab
  zinit light zsh-users/zsh-syntax-highlighting
fi

# OMZ calls compinit — must happen after Zinit init
[[ -f "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

# Replay deferred Zinit completions after compinit
(( ${+functions[zinit]} )) && zinit cdreplay -q

setopt autocd histignorespace rm_star_silent

{{- if and (not .ephemeral) .personal }}
export GITHUB_TOKEN={{ onepasswordRead "op://Private/GitHub PAT/token" | trim }}
{{- end }}

# Modular shell config (mise activation, tools, aliases, functions)
[[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/shell-loader.sh" ]] && \
  source "${XDG_CONFIG_HOME:-$HOME/.config}/shell-loader.sh"

# Machine-local overrides (not tracked by chezmoi)
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

[[ -n "$ZPROF" ]] && zprof || true
{{- /* vim: set filetype=zsh: */}}
