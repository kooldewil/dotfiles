# XDG Base Directory Specification (single source of truth)
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"

# Prevent PATH duplicates (zsh built-in)
typeset -U path fpath manpath
typeset +x FPATH

# Core paths — remove-then-prepend to survive macOS path_helper reordering
path=("$HOME/.local/bin" ${path:#$HOME/.local/bin})

{{- if eq .chezmoi.os "darwin" }}
path=("/opt/homebrew/bin" ${path:#/opt/homebrew/bin})
{{- end }}

# Core environment
export EDITOR=nvim
export PAGER=less
export LESS=FRX
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# XDG-aware tool redirects — keep $HOME clean
export CARGO_HOME="${XDG_DATA_HOME}/cargo"
export RUSTUP_HOME="${XDG_DATA_HOME}/rustup"
export DOCKER_CONFIG="${XDG_CONFIG_HOME}/docker"
export GNUPGHOME="${XDG_DATA_HOME}/gnupg"
export LESSHISTFILE="${XDG_STATE_HOME}/less/history"
export NPM_CONFIG_USERCONFIG="${XDG_CONFIG_HOME}/npm/npmrc"
export PYTHON_HISTORY="${XDG_STATE_HOME}/python_history"
export RIPGREP_CONFIG_PATH="${XDG_CONFIG_HOME}/ripgrep/config"

# Cargo and Go bins (tools installed outside mise)
[[ -d "${CARGO_HOME}/bin" ]] && path=("${CARGO_HOME}/bin" ${path:#${CARGO_HOME}/bin})
[[ -d "$HOME/go/bin" ]] && path=("$HOME/go/bin" ${path:#$HOME/go/bin})

{{- if eq .chezmoi.os "darwin" }}
# 1Password SSH Agent (skip when SSH'd — biometric unavailable)
if [[ -z "$SSH_CONNECTION" ]]; then
    export SSH_AUTH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
fi

# Prevent brew from reinstalling tools managed by mise
export HOMEBREW_FORBIDDEN_FORMULAE="atuin bat carapace chezmoi eza fd fzf gh git-delta gitleaks glow go golangci-lint jj jless jq lazygit neovim python ripgrep topgrade tokei uv yq yt-dlp zoxide"
{{- end }}

# Local overrides (machine-specific, not tracked by chezmoi)
[[ -f "${HOME}/.zshenv.local" ]] && source "${HOME}/.zshenv.local"
