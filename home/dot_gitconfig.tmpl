[user]
	name = {{ get . "name" | default "" }}
	email = {{ get . "email" | default "" }}
{{- if .personal }}
	signingkey = ssh-ed25519 PLACEHOLDER
[gpg]
	format = ssh
[commit]
	gpgsign = true
{{- end }}

[core]
	editor = nano
	autocrlf = {{ if eq .chezmoi.os "windows" }}true{{ else }}input{{ end }}
	excludesfile = ~/.gitignore_global
{{- if lookPath "delta" }}
	pager = delta
{{- end }}

[init]
	defaultBranch = main

[pull]
	rebase = false

[push]
	default = simple
	autoSetupRemote = true

[color]
	ui = auto

[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold

[color "status"]
	added = green
	changed = yellow
	untracked = cyan

[alias]
	# Short status
	s = status -sb

	# Add all
	aa = add --all

	# Commit
	c = commit
	cm = commit -m

	# Pretty log
	l = log --pretty=format:'%C(yellow)%h%C(reset) - %C(cyan)%an%C(reset), %C(green)%ar%C(reset) : %s'
	lg = log --graph --pretty=format:'%C(yellow)%h%C(reset) - %C(cyan)%an%C(reset), %C(green)%ar%C(reset) : %s' --abbrev-commit

	# Show branches
	branches = branch -a

	# Undo last commit
	undo = reset HEAD~1 --mixed

	# Amend last commit
	amend = commit --amend --no-edit

	# Show diff of last commit
	last = diff HEAD^

	# Stash
	stash-all = stash save --include-untracked

[diff]
	tool = default-difftool
{{- if lookPath "delta" }}

[delta]
	navigate = true
	light = false
	side-by-side = true
	line-numbers = true

[interactive]
	diffFilter = delta --color-only
{{- end }}

[merge]
	tool = default-mergetool
	conflictstyle = diff3

[fetch]
	prune = true

[help]
	autocorrect = 1

{{- if lookPath "gh" }}
[credential "https://github.com"]
	helper = !gh auth git-credential
{{- end }}

{{ if eq .chezmoi.os "windows" -}}
[credential]
	helper = manager
{{ end -}}
